# Copy this file to .env. The real file is ignored by git.
OPENROUTER_API_KEY=replace-me

# The free router selects a currently available model that supports the request.
OPENROUTER_MODEL=openrouter/free

# Optional exact capacity override. OpenRouter otherwise resolves its catalog.
# OPENROUTER_CONTEXT_WINDOW=128000

# Optional OpenRouter app-attribution fields.
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_APP_TITLE=deepseek-cordis

# Optional durable session storage. Reusing both values resumes the session.
# HARNESS_SESSION_DIR=.sessions
# HARNESS_SESSION_ID=calculator-demo

# Optional root for the approved create_workspace_file operation.
# Defaults to the process launch directory.
# HARNESS_WORKSPACE_ROOT=/absolute/path/to/workspace
