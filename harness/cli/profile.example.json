{
  "schemaVersion": 1,
  "name": "coding",
  "model": {
    "provider": "openrouter",
    "id": "openrouter/free",
    "contextWindow": 128000,
    "retry": {
      "maxRetries": 2,
      "initialDelayMs": 250,
      "maxDelayMs": 5000
    },
    "routing": {
      "allowFallbacks": true,
      "requireParameters": true,
      "dataCollection": "allow",
      "sort": "throughput"
    }
  },
  "workspace": {
    "root": ".",
    "maxFileBytes": 1048576
  },
  "process": {
    "backend": "local",
    "allowedPrograms": ["git", "node", "npm", "npx", "rg"],
    "timeoutMs": 120000,
    "maxTimeoutMs": 600000,
    "maxOutputBytes": 64000,
    "killGraceMs": 3000
  },
  "persistence": {
    "kind": "file",
    "directory": ".sessions"
  },
  "tools": {
    "enabled": [
      "add",
      "workspace.read",
      "workspace.list",
      "workspace.find",
      "workspace.stat",
      "workspace.write",
      "workspace.edit",
      "workspace.preview_patch",
      "workspace.patch",
      "workspace.move",
      "workspace.delete",
      "workspace.command"
    ]
  },
  "prompt": {
    "identity": true,
    "workspaceGuidance": true,
    "persona": "Act as a careful coding agent. Inspect relevant files before editing."
  },
  "instructions": {
    "enabled": true,
    "directory": ".",
    "maxBytes": 65536,
    "maxSourceBytes": 1048576,
    "projectRootMarkers": [".git"],
    "instructionFileCandidates": ["AGENTS.md", "CLAUDE.md"],
    "localInstructionFileCandidates": ["AGENTS.local.md", "CLAUDE.local.md"]
  },
  "approval": {
    "default": "ask"
  },
  "context": {
    "thresholdRatio": 0.8,
    "retainTurns": 1,
    "maxOverflowRetries": 1
  }
}
